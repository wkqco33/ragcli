# ragcli configuration example. Copy this file to `.env` and fill in your own values.
# WConf reads this file with the same names used for environment variable bindings in chat.hpp.

# Ollama settings (no API key needed for local Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Embedding model for `ragcli rag` (used by Ollama)
OLLAMA_EMBED_MODEL=nomic-embed-text

# Qdrant settings for `ragcli rag` (Qdrant REST API)
QDRANT_BASE_URL=http://localhost:6333
QDRANT_COLLECTION=documents

# Commercial provider API keys (used by llm_client when those providers are selected)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_claude_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_BASE_URL=https://your-resource-name.openai.azure.com/
