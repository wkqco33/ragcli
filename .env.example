# ragcli configuration example. Copy this file to `.env` and fill in your own values.
# WConf reads this file with the same names used for environment variable bindings.

# Which LLM provider `rag`/`chat` use. One of: ollama (default), openai, azure.
LLM_PROVIDER=ollama

# Ollama settings (used when LLM_PROVIDER=ollama, no API key needed for local Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_EMBED_MODEL=nomic-embed-text

# OpenAI settings (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small

# Azure OpenAI settings (used when LLM_PROVIDER=azure)
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_BASE_URL=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_MODEL=your-chat-deployment-name
AZURE_OPENAI_EMBED_MODEL=your-embedding-deployment-name
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Qdrant settings for `ragcli rag` (Qdrant REST API)
QDRANT_BASE_URL=http://localhost:6333
QDRANT_COLLECTION=documents
# QDRANT_DISTANCE=Cosine   # Cosine (default) | Euclid | Dot | Manhattan

# Simple/markdown chunker tuning for `ragcli rag` indexing (character counts)
# CHUNK_SIZE=512
# CHUNK_OVERLAP=64

# Number of neighboring chunks (before/after) to pull in around each search hit
# when answering a query with `ragcli rag -q`. 0 disables expansion (default).
# Expanding costs extra prompt tokens (roughly x(1+2N)) but gives the LLM more
# surrounding context per hit.
# EXPAND_NEIGHBORS=0

# Result reranking for `ragcli rag -q`. One of: lexical (default) | none.
# lexical fetches a wider candidate pool from Qdrant, scores it with local
# BM25 keyword matching, and fuses that with the vector rank (Reciprocal Rank
# Fusion) before truncating to --top-k. Pure local computation, no extra
# network/LLM calls. Helps especially for queries with exact keywords/proper
# nouns that dense embeddings sometimes under-rank.
# RERANK_MODE=lexical

# How many candidates to pull from Qdrant before lexical reranking. 0 means
# auto: max(top_k * 4, 20).
# RERANK_CANDIDATES=0
